generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  phone     String?
  company   String?
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  buildings Building[]
  accounts  Account[]
  sessions  Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Building {
  id          String      @id @default(cuid())
  name        String
  address     String
  city        String
  description String?
  image       String?
  floorCount  Int
  aptPerFloor Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  apartments  Apartment[]
}

model Apartment {
  id          String     @id @default(cuid())
  number      String
  floor       Int
  type        String
  size        Float?
  status      String     @default("AVAILABLE")
  price       Float?
  description String?
  buildingId  String
  building    Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  customer    Customer?
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Customer {
  id          String     @id @default(cuid())
  name        String
  phone       String
  email       String?
  idNumber    String?
  address     String?
  saleDate    DateTime?
  salePrice   Float
  notes       String?
  apartmentId String     @unique
  apartment   Apartment  @relation(fields: [apartmentId], references: [id])
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Payment {
  id          String    @id @default(cuid())
  amount      Float
  type        String
  date        DateTime
  note        String?
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])
  createdAt   DateTime  @default(now())
}
